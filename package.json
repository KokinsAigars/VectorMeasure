{
  "name": "vectormeasure",
  "version": "0.0.8",
  "description": "A simple PDF measurement tool",
  "main": "server.js",
  "author": "Aigars Kokins",
  "license": "MIT",
  "keywords": [
    "pdf",
    "vector",
    "html measure"
  ],
  "scripts": {
    "dev": "concurrently \"node server.js\"",
    "test": "vitest --run --reporter verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/node": "^24.3.0",
    "express": "^5.1.0",
    "npm": "^11.5.2"
  },
  "devDependencies": {
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "happy-dom": "^18.0.1",
    "playwright": "^1.55.0",
    "vitest": "^3.2.4"
  }
}
